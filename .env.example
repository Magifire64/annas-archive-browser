# Anna's [local] Archive - Environment Configuration
# Copy this file to .env and modify the values as needed

# MariaDB Configuration
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_USER=annas
MARIADB_PASSWORD=annas_archive
MARIADB_DATABASE=annas_archive

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# qBittorrent Configuration
QBITTORRENT_HOST=qbittorrent
QBITTORRENT_PORT=8080

# Paths
TORRENTS_PATH=/data/torrents
METADATA_PATH=/data/metadata

# Web Application
FLASK_ENV=production
FLASK_DEBUG=false

# Optional: Change these if you need different ports
# WEB_PORT=8000
# TORRENT_UI_PORT=8080
# MARIADB_EXTERNAL_PORT=3306
# ES_EXTERNAL_PORT=9200
